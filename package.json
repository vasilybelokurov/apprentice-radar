{
  "name": "apprentice-radar",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": "24.x"
  },
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "sync": "node scripts/sync.ts",
    "sync:local": "DFE_API_KEY=\"$(security find-generic-password -s apprentice-radar-dfe-key -w)\" node scripts/sync.ts",
    "verify:dfe": "DFE_API_KEY=\"$(security find-generic-password -s apprentice-radar-dfe-key -w)\" node scripts/verify-dfe-api.ts",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "check": "npm run typecheck && npm test",
    "alerts": "node scripts/send-alerts.ts"
  },
  "dependencies": {
    "nodemailer": "10.0.12",
    "zod": "4.6.5"
  },
  "devDependencies": {
    "@types/node": "24.19.0",
    "@types/nodemailer": "8.0.2",
    "typescript": "7.0.2",
    "vite": "8.3.1",
    "vitest": "5.0.2"
  }
}
